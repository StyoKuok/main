@misc{guo2026objecttwin,
  title={ObjectTwin: Measuring the Asset Correspondence Gap for Capture-Anchored Digital Twins},
  author={Guo, Zhenghe},
  year={2026},
  keywords={embodied, 3D reconstruction, digital twins},
  selected={true},
  preview={objecttwin-office2.gif},
  website={https://styokuok.github.io/sim_ready/},
  abstract={We study instance-level reconstruction from captured RGB-D scenes and the correspondence gap between a generated asset and the physical object it is intended to represent. ObjectTwin combines instance segmentation, VLM-based filtering, generative mesh completion, scan-guided scene composition, and pose refinement, then exposes scene-level comparisons that make residual geometry, orientation, scale, and layout mismatch measurable.}
}

