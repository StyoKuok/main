@unpublished{guo2026consequences,
  title={Beyond State Prediction: Learning Action Consequences in Visual Physical Systems},
  author={Guo, Zhenghe},
  year={2026},
  note={Submitted},
  keywords={embodied, world models, physical systems, action consequences, visual representations, fluids, action-conditioned prediction},
  selected={true},
  preview={fluid_history.png},
  website={https://styokuok.github.io/vis_phys/},
  abstract={We evaluate what visual representations preserve for comparing actions in physical systems. Restoring the same simulator state for each candidate action yields complete response tables that separate current-state accessibility, action-conditioned consequence prediction, and realized decision utility. Controlled fluid experiments test hidden-motion ambiguity, held-out actions, and extrapolation beyond fitted action support.}
}

